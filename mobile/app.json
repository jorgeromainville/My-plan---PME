{
  "name": "My Plan",
  "slug": "my-plan",
  "version": "0.1.0",
  "scheme": "myplan",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "backgroundColor": "#FAF6EF"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "app.myplan.today",
    "buildNumber": "1"
  },
  "android": {
    "package": "app.myplan.today",
    "versionCode": 1,
    "adaptiveIcon": {
      "backgroundColor": "#FAF6EF"
    }
  },
  "plugins": [
    "expo-router",
    "@react-native-community/datetimepicker",
    "expo-localization",
    "expo-camera",
    "expo-notifications"
  ],
  "experiments": {
    "typedRoutes": true
  }
}
