{
  "name": "My Plan",
  "slug": "my-plan",
  "version": "1.0.0",
  "scheme": "myplan",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "backgroundColor": "#FAF6EF"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "app.myplan.today",
    "buildNumber": "1"
  },
  "android": {
    "package": "app.myplan.today",
    "versionCode": 2,
    "adaptiveIcon": {
      "backgroundColor": "#FAF6EF"
    },
    "permissions": [
      "android.permission.CAMERA",
      "android.permission.RECORD_AUDIO"
    ]
  },
  "plugins": [
    "expo-router",
    "@react-native-community/datetimepicker",
    "expo-localization",
    "expo-camera",
    "expo-notifications",
    "expo-sqlite"
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "router": {},
    "eas": {
      "projectId": "e9ecd6df-496e-4611-a99c-87d44e8965d1"
    }
  },
  "owner": "romainville"
}
