DATABASE_URL="postgresql://planner:planner@localhost:5432/planner?schema=public"
JWT_SECRET="cambia-esto-en-produccion"
JWT_REFRESH_SECRET="cambia-esto-tambien"
PORT=4000
# Orígenes de navegador permitidos además de localhost (coma-separados).
# La app móvil no manda Origin, así que no hace falta tocar esto.
CORS_ORIGINS=""
# OCR de horarios (gratis, sin tarjeta): crea tu key en https://ocr.space/ocrapi
OCRSPACE_KEY=""
OCR_PROVIDER="ocrspace" # ocrspace | mlkit (mlkit = offline, requiere dev build)
# IA que "entiende" la foto del horario (lee tablas, columnas y fotos giradas).
# Gratis y sin tarjeta: https://aistudio.google.com/apikey  →  AI_PROVIDER="none" la apaga.
AI_PROVIDER="none" # gemini | none
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_MODEL_FALLBACKS="gemini-3-flash-preview,gemini-flash-latest"
# Login con Google: client ID de tipo "Web" del proyecto de Google Cloud.
# Es público (la app lo pide a GET /api/auth/google/config); el backend lo usa
# como audiencia al validar el idToken.
GOOGLE_CLIENT_ID=""
